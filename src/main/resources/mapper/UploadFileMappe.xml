<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
   "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper	namespace="project.DIY.repository.mybatis.UploadFileMapper">

<!-- 로그인 -->
<!-- id는 인터페이스 메소드명과 동일 -->

	
    <insert id="save" parameterType="project.DIY.domain.UploadFile">
		INSERT INTO diydb.uploadfile
		VALUES (
			null,
			#{fileName}, 
			#{saveFileName},
			#{filePath}, 
			#{contentType},
			#{size}
			);
	</insert>
    
    <select id="findById" parameterType="java.lang.String">
		select * from diydb.uploadfile where id = #{fileId};   
    </select>
    
    <select id="selectBySaveFileName" parameterType="java.lang.String">
        select id from diydb.uploadfile where saveFileName = #{saveFileName};
	</select>
</mapper>